### =============================
### Payment Service API Tests
### =============================
### Prerequisite: payment-service must be running on port 8084.
### Run these requests sequentially from top to bottom.

### 1. Calculate fare for a ride
POST http://localhost:8084/api/payments/calculate
Content-Type: application/json

{
  "rideId": "ride-123",
  "riderId": "rider-123",
  "driverId": "driver-123",
  "distance": 8.5
}

> {%
    client.test("Fare calculated successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.amount === 177.5, "Amount should match base fare + distance rate");
    });
%}

###

### 2. Process payment for a completed ride
POST http://localhost:8084/api/payments/process
Content-Type: application/json

{
  "rideId": "ride-123",
  "riderId": "rider-123",
  "driverId": "driver-123",
  "distance": 8.5
}

> {%
    client.test("Payment processed successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.status === "COMPLETED", "Status should be COMPLETED");
        client.assert(response.body.amount === 177.5, "Amount should match calculated fare");
    });
    client.global.set("paymentId", response.body.id);
%}

###

### 3. Get payment by id (uses the processed payment)
GET http://localhost:8084/api/payments/{{paymentId}}

> {%
    client.test("Payment fetched successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.id === client.global.get("paymentId"), "Payment id should match");
    });
%}

###

### 4. Get payment by ride id (uses the processed ride id)
GET http://localhost:8084/api/payments/ride/ride-123

> {%
    client.test("Payment by ride fetched successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.id === client.global.get("paymentId"), "Payment id should match");
    });
%}

###

### 5. Get payments by rider id (uses the processed rider id)
GET http://localhost:8084/api/payments/rider/rider-123

> {%
    client.test("Rider payment history returned", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(Array.isArray(response.body), "Response should be a list");
    });
%}

###

### 6. Get payments by driver id (uses the processed driver id)
GET http://localhost:8084/api/payments/driver/driver-123

> {%
    client.test("Driver earnings history returned", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(Array.isArray(response.body), "Response should be a list");
    });
%}