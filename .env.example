# MongoDB Atlas credentials and cluster.
# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# Find the host in Atlas under Connect -> Drivers. In a connection string like
#   mongodb+srv://user:pass@cluster0.ab12cde.mongodb.net/?appName=Cluster0
# the host is the part after '@' and before '/', e.g. cluster0.ab12cde.mongodb.net
#
# Every service appends its own database name to this host, so all five share
# one cluster while keeping separate databases.
MONGO_DB_USER=your_mongodb_username_here
MONGO_DB_PASS=your_mongodb_password_here
MONGO_CLUSTER_HOST=your_cluster_host_here.mongodb.net

# Stripe test-mode API keys, used by payment-service (org.uber.paymentservice.config.StripeConfig).
# Find these in the Stripe Dashboard under Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLIC_KEY=pk_test_your_key_here
